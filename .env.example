APP_NAME=SHOFEER
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Aden
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

AUTH_GUARD=web
AUTH_PASSWORD_BROKER=users
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
AUTH_PASSWORD_TIMEOUT=10800

BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database - MySQL / XAMPP
# -----------------------------------------------------------------------------

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shofeer
DB_USERNAME=root
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# false محلياً لأننا نعمل عبر HTTP.
# في الإنتاج ستصبح true مع HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true

# Lax مطلوب حالياً حتى تعمل دورة Google OAuth بشكل سليم.
# إعدادات الإنتاج النهائية ستراجع في مرحلة الأمان والنشر.
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Cache / Queue / Broadcasting
# -----------------------------------------------------------------------------

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=shofeer_

# -----------------------------------------------------------------------------
# Redis - سيتم تفعيله في مرحلة لاحقة
# -----------------------------------------------------------------------------

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@shofeer.local"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# -----------------------------------------------------------------------------
# AWS - غير مستخدم حالياً
# -----------------------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------

VITE_APP_NAME="${APP_NAME}"