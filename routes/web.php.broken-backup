<?php

use App\Http\Controllers\Auth\GoogleAuthController;
use App\Http\Controllers\Auth\LoginController;
use App\Http\Controllers\Auth\LogoutController;
use App\Http\Controllers\Auth\RegisterController;
use App\Http\Controllers\BookingController;
use App\Http\Controllers\SeatController;
use App\Http\Controllers\TripController;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Route;

/*
|--------------------------------------------------------------------------
| Home
|--------------------------------------------------------------------------
*/

Route::view(
    '/',
    'home'
)->name('home');

/*
|--------------------------------------------------------------------------
| Public Trips
|--------------------------------------------------------------------------
*/

Route::get(
    '/trips',
    [
        TripController::class,
        'index',
    ]
)->name('trips.index');

Route::get(
    '/trips/{trip}',
    [
        TripController::class,
        'show',
    ]
)->name('trips.show');

/*
|--------------------------------------------------------------------------
| Guest Authentication
|--------------------------------------------------------------------------
*/

Route::middleware(
    'guest'
)->group(
    function (): void {
        /*
        |--------------------------------------------------------------------------
        | Login
        |--------------------------------------------------------------------------
        */

        Route::get(
            '/login',
            [
                LoginController::class,
                'create',
            ]
        )->name('login');

        Route::post(
            '/login',
            [
                LoginController::class,
                'store',
            ]
        )
            ->middleware(
                'throttle:5,1'
            )
            ->name(
                'login.store'
            );

        /*
        |--------------------------------------------------------------------------
        | Passenger Registration
        |--------------------------------------------------------------------------
        */

        Route::get(
            '/register',
            [
                RegisterController::class,
                'create',
            ]
        )->name('register');

        Route::post(
            '/register',
            [
                RegisterController::class,
                'store',
            ]
        )
            ->middleware(
                'throttle:3,60'
            )
            ->name(
                'register.store'
            );

        /*
        |--------------------------------------------------------------------------
        | Google OAuth
        |--------------------------------------------------------------------------
        */

        Route::get(
            '/auth/google/redirect',
            [
                GoogleAuthController::class,
                'redirect',
            ]
        )
            ->middleware(
                'throttle:10,1'
            )
            ->name(
                'auth.google.redirect'
            );

        Route::get(
            '/auth/google/callback',
            [
                GoogleAuthController::class,
                'callback',
            ]
        )
            ->middleware(
                'throttle:10,1'
            )
            ->name(
                'auth.google.callback'
            );
    }
);

/*
|--------------------------------------------------------------------------
| Authenticated Routes
|--------------------------------------------------------------------------
*/

Route::middleware(
    'auth'
)->group(
    function (): void {
        /*
        |--------------------------------------------------------------------------
        | Logout
        |--------------------------------------------------------------------------
        */

        Route::post(
            '/logout',
            LogoutController::class
        )->name('logout');

        /*
        |--------------------------------------------------------------------------
        | Passenger Dashboard
        |--------------------------------------------------------------------------
        */

        Route::get(
            '/dashboard',
            function (
                Request $request
            ) {
                return response()->json([
                    'message' =>
                        'SHOFEER passenger area is ready.',

                    'user' => [
                        'id' =>
                            $request
                                ->user()
                                ->id,

                        'name' =>
                            $request
                                ->user()
                                ->name,

                        'role' =>
                            $request
                                ->user()
                                ->role
                                ->value,
                    ],
                ]);
            }
        )
            ->middleware(
                'role:passenger'
            )
            ->name(
                'dashboard'
            );

        /*
        |--------------------------------------------------------------------------
        | Passenger Booking Flow
        |--------------------------------------------------------------------------
        */

        Route::middleware(
            'role:passenger'
        )->group(
            function (): void {
                /*
                |--------------------------------------------------------------------------
                | Seat Selection
                |--------------------------------------------------------------------------
                */

                Route::get(
                    '/trips/{trip}/seats',
                    [
                        SeatController::class,
                        'show',
                    ]
                )->name(
                    'trips.seats.show'
                );

                Route::post(
                    '/trips/{trip}/seats',
                    [
                        SeatController::class,
                        'store',
                    ]
                )
                    ->middleware(
                        'throttle:10,1'
                    )
                    ->name(
                        'trips.seats.store'
                    );

                /*
                |--------------------------------------------------------------------------
                | Payment
                |--------------------------------------------------------------------------
                */

                Route::get(
                    '/booking/{booking}/pay',
                    [
                        BookingController::class,
                        'pay',
                    ]
                )->name(
                    'booking.pay'
                );

                Route::post(
                    '/booking/{booking}/pay',
                    [
                        BookingController::class,
                        'submitPayment',
                    ]
                )
                    ->middleware(
                        'throttle:5,1'
                    )
                    ->name(
                        'booking.pay.submit'
                    );

                /*
                |--------------------------------------------------------------------------
                | Pending
                |--------------------------------------------------------------------------
                */

                Route::get(
                    '/booking/{booking}/pending',
                    [
                        BookingController::class,
                        'pending',
                    ]
                )->name(
                    'booking.pending'
                );

                /*
                |--------------------------------------------------------------------------
                | Success
                |--------------------------------------------------------------------------
                */

                Route::get(
                    '/booking/{booking}/success',
                    [
                        BookingController::class,
                        'success',
                    ]
                )->name(
                    'booking.success'
                );

                /*
                |--------------------------------------------------------------------------
                | Failed
                |--------------------------------------------------------------------------
                */

                Route::get(
                    '/booking/{booking}/failed',
                    [
                        BookingController::class,
                        'failed',
                    ]
                )->name(
                    'booking.failed'
                );
            }
        );
    }
);